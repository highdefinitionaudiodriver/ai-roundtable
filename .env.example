# Optional. The app also works without API keys as a prompt router.
# 設定したプロバイダだけがアプリ内実行で使えます（未設定でも共有/コピーは無料で使えます）。

# --- OpenAI Chat Completions 互換プロバイダ ---
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# --- 個別実装プロバイダ ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
XAI_MODEL=grok-2-latest
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-large-latest
DEEPSEEK_MODEL=deepseek-chat
PERPLEXITY_MODEL=sonar
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash

# Optional output token limits (per provider).
OPENAI_MAX_TOKENS=1000
XAI_MAX_TOKENS=1000
GROQ_MAX_TOKENS=1000
MISTRAL_MAX_TOKENS=1000
DEEPSEEK_MAX_TOKENS=1000
PERPLEXITY_MAX_TOKENS=1000
ANTHROPIC_MAX_TOKENS=1000
GEMINI_MAX_OUTPUT_TOKENS=1000

# Optional server port.
AI_ROUNDTABLE_PORT=8787
